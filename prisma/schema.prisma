generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGO")
}

type MemberWarnData {
  id    String @map("_id")
  warns Warn[]
}

type Warn {
  id         String   @map("_id")
  date       DateTime @db.Date
  expiration DateTime @db.Date
  mod        String
  reason     String
  severity   Int
}

type WarnAction {
  action     String
  severity   Int
  expiration Int?
}

model blacklist {
  id        String    @id @map("_id")
  createdAt DateTime? @db.Date
  reason    String
  updatedAt DateTime? @db.Date
}

model guildSettings {
  id            String    @id @map("_id")
  adminRoles    String[]
  configured    Boolean
  createdAt     DateTime? @db.Date
  isCommunity   Boolean?
  modLogChannel String
  modRoles      String[]
  updatedAt     DateTime? @db.Date
}

model guildWarns {
  id        String           @id @map("_id")
  createdAt DateTime?        @db.Date
  updatedAt DateTime?        @db.Date
  warnlist  MemberWarnData[]
  actions   WarnAction[]
  revision  Int?
}

model nicknames {
  id        String    @id @map("_id")
  createdAt DateTime? @db.Date
  updatedAt DateTime? @db.Date
  freezed   String[]
}

model memberCodes {
  id          String    @id @map("_id")
  createdAt   DateTime? @db.Date
  updatedAt   DateTime? @db.Date
  memberCodes String[]
}

model aiChatConfig {
  id              String   @id @map("_id") // channelId
  guildId         String
  enabled         Boolean  @default(true)
  targetUserIds   String[] // Specific users to interact with, empty = everyone
  motive          String? // Optional goal/motive for the AI
  createdAt       DateTime @default(now()) @db.Date
  updatedAt       DateTime @updatedAt @db.Date
  createdBy       String // Owner who enabled it
  personalityMode String   @default("default") // For future: different personality modes
}

// Created before changing Discord permissions. Do not TTL-delete restoration data.
model channelLockSnapshot {
  id             String    @id @map("_id")
  guildId        String
  targetId       String
  roleId         String
  kind           String
  snapshot       String
  operationToken String
  leaseUntil     DateTime? @db.Date
  expiresAt      DateTime? @db.Date
  retryAfter     DateTime? @db.Date
  createdAt      DateTime  @db.Date

  @@index([guildId])
  @@index([expiresAt])
}

model automodConfig {
  id                  String    @id @map("_id")
  alertChannelId      String
  exemptRoleIds       String[]
  exemptChannelIds    String[]
  floodMode           String    @default("off")
  floodThreshold      Int       @default(6)
  duplicateThreshold  Int       @default(3)
  windowSeconds       Int       @default(10)
  linkMode            String    @default("off")
  blockedDomains      String[]
  allowedDomains      String[]
  allowedInviteCodes  String[]  @default([])
  blockInvites        Boolean   @default(false)
  raidMode            String    @default("off")
  raidThreshold       Int       @default(10)
  raidWindowSeconds   Int       @default(10)
  raidDurationSeconds Int       @default(600)
  raidRestoreLevel    Int?
  raidRestoreAt       DateTime? @db.Date
  raidLeaseToken      String?
  raidLeaseUntil      DateTime? @db.Date
  updatedAt           DateTime  @updatedAt @db.Date

  @@index([raidRestoreAt])
}

// Hash keys avoid storing member codes or coupon codes in redemption history.
model redemptionReceipt {
  id        String   @id @map("_id")
  token     String
  status    String
  expiresAt DateTime @db.Date
  updatedAt DateTime @db.Date
}

model redemptionAccountLabel {
  id   String @id @map("_id")
  name String
}

model redemptionGuildPolicy {
  id        String  @id @map("_id")
  roleId    String?
  channelId String?
}

// Additive: no changes to existing Solo Leveling account documents.
model supporterPass {
  id        String   @id @map("_id")
  userId    String
  provider  String
  expiresAt DateTime @db.Date
  @@index([userId, expiresAt])
}

model couponSubscription {
  id        String   @id @map("_id")
  userId    String
  guildId   String
  game      String
  enabled   Boolean
  createdAt DateTime @db.Date
  @@index([guildId, game, enabled])
}

model couponAlert {
  id         String    @id @map("_id")
  guildId    String
  channelId  String
  game       String
  code       String
  messageUrl String
  cursor     String
  createdAt  DateTime  @db.Date
  expiresAt  DateTime  @db.Date
  couponExpiresAt DateTime? @db.Date
  leaseToken String?
  leaseUntil DateTime? @db.Date
  @@index([expiresAt])
}

// New collections are additive. Existing guild warning documents are unchanged.
type ModerationCaseNote {
  actorId String
  text String
  createdAt DateTime @db.Date
}

type ModerationReasonEdit {
  actorId String
  previous String
  reason String
  createdAt DateTime @db.Date
}

model moderationCase {
  id String @id @map("_id")
  guildId String
  targetId String
  actorId String
  action String
  reason String
  createdAt DateTime @default(now()) @db.Date
  notes ModerationCaseNote[]
  reasonEdits ModerationReasonEdit[]
  logMessageId String?
  sourceUrl String?
  @@index([guildId, targetId, createdAt])
  @@index([guildId, logMessageId])
}

model moderationReportSettings {
  id String @id @map("_id")
  channelId String
}

model moderationReport {
  id String @id @map("_id")
  guildId String
  channelId String
  messageId String
  targetId String
  reporterId String
  messageUrl String
  excerpt String
  status String @default("pending")
  createdAt DateTime @default(now()) @db.Date
  reviewedAt DateTime? @db.Date
  reviewerId String?
  reviewAction String?
  reviewMessageId String?
  @@index([guildId, status, createdAt])
}

model moderationScheduledBan {
  id String @id @map("_id")
  generation String
  guildId String
  targetId String
  actorId String
  expectedReason String
  dueAt DateTime @db.Date
  status String
  leaseOwner String?
  leaseUntil DateTime? @db.Date
  nextAttemptAt DateTime @db.Date
  createdAt DateTime @default(now()) @db.Date
  completedAt DateTime? @db.Date
  lastError String?
  @@index([status, nextAttemptAt])
}
